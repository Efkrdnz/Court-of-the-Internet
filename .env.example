# Copy to .env and adjust. Everything here works out of the box with `npm run db:up`.
DATABASE_URL="postgresql://court:court@localhost:5432/court_dev?schema=public"
# Used by `npm test` integration tests (separate database, wiped between runs)
TEST_DATABASE_URL="postgresql://court:court@localhost:5432/court_test?schema=public"
# Required in production: long random string used to pepper session token hashes
SESSION_SECRET="dev-only-change-me-in-production-0123456789abcdef"
# Optional: enables POST /api/cron/maintenance with `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Gameplay tuning
COURT_QUORUM=10
COURT_DELIBERATION_HOURS=24
COURT_MAX_EXTENSIONS=1
COURT_CLAIM_MINUTES=30
# One-click demo accounts on /login (defaults to on outside production)
ENABLE_DEMO_LOGIN="true"
